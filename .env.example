# Copy to .env for local development. Never put real secrets in this file.

# Optional. Leave blank for the clearly labeled, free local demo.
# Create a Gemini API key at https://aistudio.google.com/apikey
# This secret is read only by the backend. Never add a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for the private provider settings dashboard and encrypted key vault.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Supabase project URL, used by FastAPI to verify signed-in user tokens.
SUPABASE_URL=
# Optional legacy Supabase HS256 signing secret. Prefer asymmetric signing keys/JWKS.
SUPABASE_JWT_SECRET=

# Optional: restrict the existing server Gemini key to one Google sign-in account.
# Users can instead add their own Gemini key in the authenticated provider settings.
AI_ANS_SERVER_PROVIDER_EMAIL=

# Keep false for local development so the backend root is the API landing page.
# Set true only when serving a built frontend from FastAPI in production.
AI_ANS_SERVE_FRONTEND=false

# Use a persistent mounted volume in hosting; local development defaults to AppData.
AI_ANS_DATA_DIR=

# Local Ollama semantic RAG is the default; pull nomic-embed-text in Ollama.
AI_ANS_RAG_BACKEND=ollama
AI_ANS_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional protected HTTPS endpoint; defaults to local Ollama.
AI_ANS_OLLAMA_EMBEDDING_URL=http://127.0.0.1:11434/api/embed
# Used only with the optional chroma-hf backend.
AI_ANS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
